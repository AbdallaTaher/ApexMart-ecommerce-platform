# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Database Connection
DATABASE=mongodb://127.0.0.1:27017/apexmart
# Or MongoDB Atlas: mongodb+srv://<USERNAME>:<PASSWORD>@cluster.mongodb.net/apexmart?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=your-ultra-secure-and-ultra-long-secret-key-32-characters-minimum
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Email Service (Nodemailer / Mailtrap for Development)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=your_mailtrap_username
EMAIL_PASSWORD=your_mailtrap_password
EMAIL_FROM="ApexMart Support <support@apexmart.com>"

# Stripe Payment Gateway (Test Mode)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Cloudinary Media Storage (Module 02: Secure File Processing)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
