{
  "name": "apexmart-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Full-Stack Amazon Clone E-Commerce Platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:unit": "vitest run",
    "test:integration": "npm --prefix backend test",
    "test:e2e": "playwright test",
    "test:db": "node backend/scripts/testDb.js",
    "seed:catalog": "node backend/scripts/seedProducts.js --import",
    "lint": "eslint . --ext .js,.jsx"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.2.5",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
